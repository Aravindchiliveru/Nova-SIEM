{
  "id": "auth.privileged-login.v1",
  "title": "Privileged account authentication",
  "severity": "medium",
  "enabled": true,
  "window_seconds": 300,
  "threshold": 1,
  "group_by": [
    "actor",
    "ip"
  ],
  "match": {
    "outcome": [
      "success"
    ],
    "actor": [
      "root",
      "Administrator"
    ],
    "category": [
      "authentication"
    ]
  }
}
