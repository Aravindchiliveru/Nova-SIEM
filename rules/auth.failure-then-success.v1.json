{
  "id": "auth.failure-then-success.v1",
  "title": "Successful authentication after repeated failures",
  "severity": "high",
  "enabled": false,
  "window_seconds": 300,
  "threshold": 5,
  "group_by": [
    "actor",
    "ip"
  ],
  "match": {
    "outcome": [
      "failure"
    ],
    "category": [
      "authentication"
    ]
  },
  "after": {
    "outcome": [
      "success"
    ],
    "category": [
      "authentication"
    ]
  },
  "window_mode": "sequence"
}
