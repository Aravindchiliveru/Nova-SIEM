{
  "id": "auth.password-spray.v1",
  "title": "Authentication failures across many accounts",
  "severity": "high",
  "enabled": true,
  "window_seconds": 300,
  "threshold": 10,
  "group_by": [
    "ip"
  ],
  "distinct": "actor",
  "match": {
    "outcome": [
      "failure"
    ],
    "category": [
      "authentication"
    ]
  }
}
