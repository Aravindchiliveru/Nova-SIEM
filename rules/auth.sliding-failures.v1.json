{
  "id": "auth.sliding-failures.v1",
  "title": "Repeated failures across fixed-window boundaries",
  "severity": "high",
  "enabled": false,
  "window_seconds": 300,
  "threshold": 5,
  "group_by": [
    "actor",
    "ip"
  ],
  "match": {
    "outcome": [
      "failure"
    ],
    "category": [
      "authentication"
    ]
  },
  "window_mode": "sliding"
}
