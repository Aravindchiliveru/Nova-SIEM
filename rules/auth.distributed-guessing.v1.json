{
  "id": "auth.distributed-guessing.v1",
  "title": "Account targeted from multiple addresses",
  "severity": "high",
  "enabled": true,
  "window_seconds": 300,
  "threshold": 5,
  "group_by": [
    "actor"
  ],
  "distinct": "ip",
  "match": {
    "outcome": [
      "failure"
    ],
    "category": [
      "authentication"
    ]
  }
}
