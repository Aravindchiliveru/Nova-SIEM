{
  "Version":"2012-10-17",
  "Statement":[
    {"Sid":"DenyPlaintextTransport","Effect":"Deny","Principal":"*","Action":"s3:*","Resource":["arn:aws:s3:::${BUCKET}","arn:aws:s3:::${BUCKET}/*"],"Condition":{"Bool":{"aws:SecureTransport":"false"}}},
    {"Sid":"ArchiveWriterCannotDeleteOrChangeBucketControls","Effect":"Deny","Principal":{"AWS":"${WRITER_ROLE_ARN}"},"Action":["s3:DeleteObject","s3:DeleteObjectVersion","s3:PutBucketVersioning","s3:PutBucketObjectLockConfiguration","s3:PutBucketPolicy","s3:DeleteBucketPolicy"],"Resource":["arn:aws:s3:::${BUCKET}","arn:aws:s3:::${BUCKET}/*"]},
    {"Sid":"WriterMustSpecifyCompliance","Effect":"Deny","Principal":{"AWS":"${WRITER_ROLE_ARN}"},"Action":"s3:PutObject","Resource":"arn:aws:s3:::${BUCKET}/nova/*","Condition":{"StringNotEquals":{"s3:object-lock-mode":"COMPLIANCE"}}}
  ]
}
